<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<GridPane hgap="15.0" vgap="12.0" alignment="CENTER" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.controldegastos.PrimaryController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <children>
      <!-- Título principal -->
      <Label text="Control de Gastos Semanales" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="4" />

      <!-- Columna izquierda: Categorías y Entradas -->
      <Label text="Alimentación" GridPane.columnIndex="0" GridPane.rowIndex="1" />
      <TextField fx:id="txtAlimentacion" promptText="800" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

      <Label text="Refrigerios" GridPane.columnIndex="0" GridPane.rowIndex="2" />
      <TextField fx:id="txtRefrigerios" promptText="300" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

      <Label text="Transporte" GridPane.columnIndex="0" GridPane.rowIndex="3" />
      <TextField fx:id="txtTransporte" promptText="600" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />

      <Label text="Telefonía" GridPane.columnIndex="0" GridPane.rowIndex="4" />
      <TextField fx:id="txtTelefonia" promptText="50" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />

      <Label text="Otros" GridPane.columnIndex="0" GridPane.rowIndex="5" />
      <TextField fx:id="txtOtros" promptText="33" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />

      <!-- Botones inferiores -->
      <Button fx:id="btnCalcular" text="Calcular estadísticas" onAction="#handleCalcular" prefWidth="135.0" GridPane.columnIndex="0" GridPane.rowIndex="6" />
      <Button fx:id="btnLimpiar" text="Limpiar" onAction="#handleLimpiar" prefWidth="80.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />

      <!-- Columna derecha: Estadísticas -->
      <Label text="Estadísticas" GridPane.columnIndex="2" GridPane.rowIndex="1" GridPane.columnSpan="2" />
      
      <Label text="Total semanal" GridPane.columnIndex="2" GridPane.rowIndex="2" />
      <TextField fx:id="txtTotalSemanal" editable="false" prefWidth="120.0" GridPane.columnIndex="2" GridPane.rowIndex="3" GridPane.columnSpan="2" />

      <Label text="Gasto más alto" GridPane.columnIndex="2" GridPane.rowIndex="4" />
      <TextField fx:id="txtGastoAlto" editable="false" prefWidth="120.0" GridPane.columnIndex="2" GridPane.rowIndex="5" GridPane.columnSpan="2" />
   </children>
</GridPane>
