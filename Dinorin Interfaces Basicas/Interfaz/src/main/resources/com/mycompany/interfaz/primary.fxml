<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.interfaz.PrimaryController">
   <children>
      <Label text="Edad de la persona" />
       <Label text="Fecha de nacimiento" />
       <TextField fx:id="txtFechaNacimiento" promptText="dd/mm/aaaa" maxWidth="200.0" />
      <Button fx:id="btnCalcular" text="Calcular" onAction="#handleCalcular" prefWidth="100.0" />
      <Button fx:id="btnLimpiar" text="Limpiar" onAction="#handleLimpiar" prefWidth="100.0" />
      <Label fx:id="lblResultado" text="Tiene 36 años con 11 meses" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
  